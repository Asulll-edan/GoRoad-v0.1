# ============================================
# STAGE 1: Builder
# ============================================
FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libc-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# ============================================
# STAGE 2: Runtime
# ============================================
FROM python:3.12-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH

COPY . .

# AI Service runtime
FROM base AS ai-service
EXPOSE 50051
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "50051"]

# Analytics Service runtime
FROM base AS analytics-service
EXPOSE 50052
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "50052"]

# Data Pipeline runtime
FROM base AS data-pipeline
CMD ["celery", "-A", "app.celery_app", "worker", "--loglevel=info", "--beat"]
